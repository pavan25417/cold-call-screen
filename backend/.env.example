# Cold Call Screen Backend Environment Variables
PORT=4000

# Supabase Credentials (from Supabase Project Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-or-anon-key

# Google AI Studio Gemini API Key (Free tier from https://aistudio.google.com/)
GEMINI_API_KEY=your-gemini-api-key-here
